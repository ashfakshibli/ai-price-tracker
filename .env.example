# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to git!

# Required: Anthropic API Key for Claude AI
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Flask secret key (will be auto-generated if not set)
# FLASK_SECRET_KEY=your_random_secret_key_here

# Optional: Database URL (defaults to SQLite: tracker.db)
# For production, Heroku will provide DATABASE_URL automatically
# DATABASE_URL=sqlite:///tracker.db

# Optional: Port (defaults to 5000 locally, Heroku sets this automatically)
# PORT=5000

# Flask Configuration (optional - not needed for production)
# FLASK_ENV=development
# FLASK_DEBUG=1
